# Maintainer: Tyler
pkgname=hintcontrol-gtk
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux GTK4 desktop app for managing T-Mobile Home Internet gateways"
arch=('x86_64')
url="https://github.com/zacharee/HINTControl"
license=('MIT')
depends=('gtk4' 'libgcc' 'glibc' 'openssl')
makedepends=('cargo')
source=()
sha256sums=()
_repo_root="$startdir/../.."

prepare() {
  cd "$_repo_root"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_repo_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

check() {
  cd "$_repo_root"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --all-features
}

package() {
  cd "$_repo_root"
  install -Dm755 "target/release/hintcontrol-gtk" "$pkgdir/usr/bin/hintcontrol-gtk"
  install -Dm644 "dist/hintcontrol-gtk.desktop" "$pkgdir/usr/share/applications/hintcontrol-gtk.desktop"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
